{"sight": [{"t": "目で見えるものの印だけ、残るよ。", "f": "web/voice/s6_be440f5e4945.m4a", "dur": 3.56}], "sound": [{"t": "耳で聴けるものの印だけ、残るよ。", "f": "web/voice/s6_393774ad9c25.m4a", "dur": 3.59}], "touch": [{"t": "さわれるものの印だけ、残るよ。", "f": "web/voice/s6_1e9b60d692df.m4a", "dur": 2.93}], "smell": [{"t": "においの印だけ、残るよ。", "f": "web/voice/s6_0300dd7c47ae.m4a", "dur": 2.58}], "taste": [{"t": "この町の食べ物の話の印だけ、残るよ。", "f": "web/voice/s6_d94f313de1ea.m4a", "dur": 4.62}], "none": [{"t": "この近くには、まだないよ。歩くと見つかるよ。", "f": "web/voice/s6_cb4ad8e3f1e6.m4a", "dur": 3.98}], "all": [{"t": "ぜんぶの感覚に、もどすよ。", "f": "web/voice/s6_843d98d16ec5.m4a", "dur": 2.54}]}